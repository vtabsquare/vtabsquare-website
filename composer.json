{
  "name": "vtabsquare/vtab-website",
  "description": "VTab Square website - CodeIgniter 4.3.7 application",
  "type": "project",
  "license": "proprietary",
  "require": {
    "php": "^8.1",
    "codeigniter4/framework": "4.3.7",
    "ext-json": "*",
    "ext-mbstring": "*",
    "ext-intl": "*"
  },
  "autoload": {
    "psr-4": {
      "App\\": "application/1.2.0/",
      "Config\\": "application/1.2.0/Config/",
      "Gaur\\": "gaur/4.3.0/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Tests\\": "tests/"
    }
  },
  "config": {
    "optimize-autoloader": true,
    "sort-packages": true
  },
  "scripts": {
    "post-install-cmd": [
      "CodeIgniter\\\\ComposerScripts::postUpdate"
    ],
    "post-update-cmd": [
      "CodeIgniter\\\\ComposerScripts::postUpdate"
    ]
  }
}
