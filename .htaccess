##
# Specify a default charset
#
AddDefaultCharset utf-8

RewriteEngine On

##
# Redirect to one canonical HTTPS hostname in a single hop.
# Keep the query string and request path intact.
RewriteCond %{HTTPS} !=on [OR]
RewriteCond %{HTTP_HOST} !^vtabsquare\.com$ [NC]
RewriteRule ^ https://vtabsquare.com%{REQUEST_URI} [R=301,L,NE]

##
# Redirect trailing slashes
#
RewriteCond %{REQUEST_URI} (.+)/$
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^ %1 [L,R=301]

##
# Remove index.php from url
#
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^ index.php [L]

##
# Prevent directory access
#
Options -Indexes

AddOutputFilterByType DEFLATE text/html text/css application/javascript


# Long-lived caching is safe only when assets have versioned URLs.
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/jpeg "access plus 6 months"
  ExpiresByType image/png "access plus 6 months"
  ExpiresByType image/svg+xml "access plus 6 months"
  ExpiresByType text/css "access plus 1 week"
  ExpiresByType application/javascript "access plus 1 week"
  ExpiresByType font/woff2 "access plus 6 months"
</IfModule>
